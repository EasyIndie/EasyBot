#!/bin/sh
# EasyBot pre-commit hook
# 安装: bin/build.rs 在 cargo build/check/test 时自动配置 core.hooksPath
#
# 提交前只运行快速检查，不通过则阻止提交。
# 更重的 clippy/test 放到 pre-push，完整验收请运行 make verify。
#
# 跳过检查（不推荐）: git commit --no-verify

set -e

# 自动检测 cargo 路径：优先 wsl cargo，fallback 到本地 cargo
if command -v cargo >/dev/null 2>&1; then
    CARGO="cargo"
elif command -v wsl >/dev/null 2>&1; then
    CARGO="wsl cargo"
else
    echo ">>> 跳过 Rust 检查（cargo 不可用）"
    exit 0
fi

# 仅在有 .rs 文件变更时才检查
if git diff --cached --name-only --diff-filter=ACMR | grep -q '\.rs$'; then
    # ── cargo fmt ──
    echo ">>> 检查 cargo fmt..."
    if ! $CARGO fmt --check 2>/dev/null; then
        echo ""
        echo ">>> cargo fmt 未通过，正在自动格式化..."
        $CARGO fmt
        echo ">>> 格式化完成。请执行: git add -u && git commit"
        echo "    （变更的文件需要重新暂存）"
        exit 1
    fi
    echo ">>> cargo fmt 通过"

    # ── cargo check ──
    echo ">>> 快速编译检查 cargo check..."
    if ! $CARGO check --workspace --features "default,plugin-system"; then
        echo ""
        echo ">>> cargo check 未通过。请修复以上 error 后重试。"
        exit 1
    fi
    echo ">>> cargo check 通过"
fi
