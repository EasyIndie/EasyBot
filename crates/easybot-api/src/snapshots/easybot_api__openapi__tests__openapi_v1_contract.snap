            "type": "integer",
            "format": "int64",
            "description": "消息保留天数（默认 90）",
            "minimum": 0
          },
          "sessionTtlDays": {
            "type": "integer",
            "format": "int64",
            "description": "会话保留天数（默认 365）",
            "minimum": 0
          }
        }
      },
