              "null"
            ],
            "description": "文本说明（可选）"
          }
        }
      },
      "SendMessageRequest": {
        "type": "object",
        "description": "发送消息请求",
        "required": [
          "target",
          "text"
        ],
        "properties": {
          "keyboard": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/InlineKeyboard",
                "description": "行内键盘（可选，如果提供则发送交互式消息，优先级低于 media）"
              }
            ]
          },
          "media": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/MediaAttachment",
                "description": "媒体附件（可选，如果提供则发送媒体消息）"
              }
            ]
          },
          "metadata": {
            "description": "平台特有元数据"
          },
          "parse_mode": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/ParseMode",
                "description": "文本解析模式（markdown / html / none）"
              }
            ]
          },
          "reply_to": {
            "type": [
              "string",
              "null"
            ],
            "description": "被回复消息 ID（可选）"
          },
          "target": {
            "type": "string",
            "description": "目标格式 \"platform:chatId\"，例如 \"telegram:123456\"",
            "example": "telegram:123456"
          },
          "text": {
            "type": "string",
            "description": "消息文本内容",
            "example": "Hello, World!"
          }
        }
      },
      "SendResult": {
        "type": "object",
        "description": "发送结果",
