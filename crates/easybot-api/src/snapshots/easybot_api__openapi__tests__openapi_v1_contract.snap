      "InboundMessage": {
        "type": "object",
        "description": "入站消息（从 IM 平台接收的消息）",
        "required": [
          "id",
          "platform",
          "msg_type",
          "sender",
          "chat_id",
          "chat_type",
          "timestamp"
        ],
        "properties": {
          "callback": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/CallbackData",
                "description": "按钮回调"
              }
            ]
          },
          "chat_id": {
            "type": "string",
            "description": "来源聊天 ID"
          },
          "chat_name": {
            "type": [
              "string",
              "null"
            ],
            "description": "聊天名称"
          },
          "chat_type": {
            "$ref": "#/components/schemas/ChatType",
            "description": "聊天类型"
          },
          "command": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/CommandData",
                "description": "斜杠命令"
              }
            ]
          },
          "guild_id": {
            "type": [
              "string",
              "null"
            ],
            "description": "所属服务器/频道 ID（Discord guild_id, QQ channel guild_id）"
          },
          "id": {
            "type": "string",
            "description": "平台消息 ID"
          },
          "media": {
            "type": [
              "array",
              "null"
            ],
            "items": {
              "$ref": "#/components/schemas/MediaAttachment"
            },
            "description": "媒体附件"
          },
          "mentioned": {
            "type": [
              "boolean",
              "null"
            ],
            "description": "是否 @了机器人（仅群聊场景有意义，None 表示不适用或未知）"
          },
          "mentions": {
            "type": [
              "array",
              "null"
            ],
            "items": {
              "$ref": "#/components/schemas/MentionInfo"
            },
            "description": "@提及列表"
          },
          "metadata": {
            "type": [
              "string",
              "null"
            ],
            "description": "平台特有元数据（JSON 字符串，使用 String 避免 serde_json::to_value 热路径创建 Value 树）"
          },
          "msg_type": {
            "$ref": "#/components/schemas/MessageType",
            "description": "消息内容类型"
          },
          "platform": {
            "type": "string",
            "description": "来源平台标识"
          },
          "recipient": {
            "type": [
              "string",
              "null"
            ],
            "description": "接收该消息的机器人 ID（用于多 bot 路由）"
          },
          "reply_to": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/MessageReference",
                "description": "回复引用"
              }
            ]
          },
          "root_id": {
            "type": [
              "string",
              "null"
            ],
            "description": "线程根消息 ID（飞书 root_id）"
          },
          "sender": {
            "$ref": "#/components/schemas/MessageSender",
            "description": "消息发送者"
          },
          "text": {
            "type": [
              "string",
              "null"
            ],
            "description": "消息文本内容"
          },
          "thread_id": {
            "type": [
              "string",
              "null"
            ],
            "description": "话题/子线程 ID"
          },
          "timestamp": {
            "type": "integer",
            "format": "int64",
            "description": "消息时间戳（毫秒）"
          }
        }
