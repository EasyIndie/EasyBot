        "required": [
          "current_version",
          "schema_version",
          "update_available",
          "requires_db_migration"
        ],
        "properties": {
          "breaking_changes": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "破坏性变更列表"
          },
          "current_version": {
            "type": "string",
            "example": "0.0.29"
          },
          "last_checked": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int64",
            "description": "上次检查时间戳（毫秒）"
          },
          "latest_schema_version": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int64",
            "description": "最新版本对应的 schema 版本"
          },
          "latest_version": {
            "type": [
              "string",
              "null"
            ],
            "description": "最新可用版本（来自 GitHub API，可能为 None 如果检查失败）"
          },
          "requires_db_migration": {
            "type": "boolean",
            "description": "是否需要数据库迁移"
          },
          "schema_version": {
            "type": "integer",
            "format": "int64",
            "description": "数据库 schema 版本"
          },
          "update_available": {
            "type": "boolean",
            "description": "是否有可用更新"
          }
        }
      },
      "UsageQuery": {
        "type": "object",
        "required": [
          "from",
          "to"
        ],
        "properties": {
          "from": {
            "type": "integer",
            "format": "int64"
          },
          "key_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "limit": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          },
          "offset": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          },
          "subject_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "to": {
            "type": "integer",
            "format": "int64"
          }
        }
      },
      "UsageRecord": {
        "type": "object",
        "description": "Durable hourly API usage suitable for invoice reconciliation.",
        "required": [
          "key_id",
          "subject_id",
          "bucket_start",
          "status_class",
          "request_count"
        ],
        "properties": {
          "bucket_start": {
            "type": "integer",
            "format": "int64",
            "description": "UTC Unix timestamp in milliseconds, truncated to the hour."
          },
          "key_id": {
            "type": "string"
          },
          "request_count": {
            "type": "integer",
            "format": "int64"
          },
          "status_class": {
            "type": "integer",
            "format": "int32",
            "description": "HTTP status class (2, 3, 4 or 5)."
          },
          "subject_id": {
            "type": "string"
          }
        }
      },
      "UsageResponse": {
        "type": "object",
        "required": [
          "from",
          "to",
          "records",
          "total_requests",
          "page_requests",
          "truncated"
        ],
        "properties": {
          "from": {
            "type": "integer",
            "format": "int64"
          },
          "next_offset": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          },
          "page_requests": {
            "type": "integer",
            "format": "int64"
          },
          "records": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/UsageRecord"
            }
          },
          "to": {
            "type": "integer",
            "format": "int64"
          },
          "total_requests": {
            "type": "integer",
            "format": "int64",
            "description": "Sum across the entire filtered time range, not only this page."
          },
          "truncated": {
            "type": "boolean"
          }
        }
      },
      "WebSocketConfig": {
        "type": "object",
        "description": "WebSocket 配置",
        "properties": {
          "enabled": {
            "type": "boolean"
          },
          "heartbeatIntervalSecs": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "maxClients": {
            "type": "integer",
            "minimum": 0
          }
        }
      },
      "WebhookConfig": {
        "type": "object",
        "description": "Webhook 配置",
        "required": [
          "name",
          "url",
          "events"
        ],
        "properties": {
          "events": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "name": {
            "type": "string"
          },
          "platforms": {
            "type": [
              "array",
              "null"
            ],
            "items": {
              "type": "string"
            }
          },
          "secret": {
            "type": [
              "string",
              "null"
            ]
          },
          "url": {
            "type": "string"
          }
        }
      }
    },
    "securitySchemes": {
      "ApiKeyAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "eb_xxxx",
        "description": "输入完整的 Bearer token，例如 `Bearer eb_xxxxxxxxxxxx`"
      }
    }
  },
  "security": [
    {
      "ApiKeyAuth": []
    }
