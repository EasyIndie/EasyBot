          },
          "metering": {
            "type": "string"
          },
          "pending_deliveries": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "pending_key_rotations": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "quota": {
            "type": "string"
          },
          "stale_pending_deliveries": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "status": {
            "type": "string"
          },
          "storage": {
            "type": "string",
