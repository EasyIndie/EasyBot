            "type": [
              "string",
              "null"
            ],
            "example": "null"
          },
          "message_id": {
            "type": [
              "string",
              "null"
            ],
            "example": "msg_abc123"
          },
          "retryable": {
            "type": "boolean",
            "example": false
          },
          "success": {
            "type": "boolean",
            "example": true
          },
          "timestamp": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int64"
          }
        }
      },
