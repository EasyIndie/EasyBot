    "/api/v1/usage": {
      "get": {
        "tags": [
          "Billing"
        ],
        "summary": "GET /api/v1/usage — export durable hourly usage for invoice reconciliation.",
        "operationId": "list_usage",
        "parameters": [
          {
            "name": "from",
            "in": "query",
            "description": "Inclusive UTC Unix milliseconds",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          },
          {
            "name": "to",
            "in": "query",
            "description": "Exclusive UTC Unix milliseconds",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          },
          {
            "name": "key_id",
            "in": "query",
            "description": "Optional internal API key ID",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "subject_id",
            "in": "query",
            "description": "Optional stable caller subject ID",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "description": "Page size, 1-1000; default 500",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 0
            }
          },
          {
            "name": "offset",
            "in": "query",
            "description": "Stable row offset",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 0
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Hourly usage records",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UsageResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid or excessive range"
          },
          "401": {
            "description": "Missing, invalid, expired, or revoked API key",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponse"
                }
              }
            }
          },
          "403": {
            "description": "API key lacks the required permission",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponse"
                }
              }
            }
          },
          "429": {
            "description": "Global, IP, or subject quota exceeded",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "Internal operation failed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponse"
                }
              }
            }
          },
          "503": {
            "description": "Durable metering, quota, storage, or adapter unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/ws": {
      "get": {
        "tags": [
          "WebSocket"
        ],
        "summary": "WebSocket 实时事件流",
        "description": "通过 WebSocket 连接订阅网关事件的实时推送。连接后需要先发送认证帧。\n认证帧示例: { \"token\": \"your-api-key\" }\n认证成功后会自动推送 message.inbound, message.sent, adapter.connected 等事件。",
        "operationId": "ws_handler",
        "responses": {
          "101": {
            "description": "WebSocket upgrade successful"
          },
          "400": {
            "description": "WebSocket upgrade failed"
          }
        },
        "security": []
      }
    }
  },
  "components": {
    "schemas": {
      "AdapterConfig": {
        "type": "object",
        "description": "适配器配置（来源自配置文件）\n\n`enabled` 支持三态：\n- `None`（默认）：自动检测 — 凭据环境变量已设置则启用\n- `Some(true)`：强制启用，即使未检测到凭据\n- `Some(false)`：强制禁用，即使凭据已设置",
        "properties": {
          "api_key": {
            "type": [
              "string",
              "null"
            ]
          },
          "base_url": {
            "type": [
              "string",
              "null"
            ],
            "description": "自定义 API 基础 URL（用于测试或代理场景，默认使用平台官方 API）"
          },
          "enabled": {
            "type": [
              "boolean",
              "null"
            ]
          },
          "extra": {},
          "token": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "AdapterItem": {
        "type": "object",
        "description": "适配器列表项",
        "required": [
          "platform",
          "display_name",
          "status",
          "connected",
          "permanent_failure",
          "retry_attempt"
        ],
        "properties": {
          "connected": {
            "type": "boolean"
          },
          "display_name": {
            "type": "string",
            "example": "Telegram"
          },
          "health": {
            "type": [
              "string",
              "null"
            ],
            "description": "传输层健康状态：Healthy, Degraded, Down\n用于区分\"适配器在运行\"和\"消息流是否正常\"",
            "example": "Healthy"
          },
          "last_error": {
            "type": [
              "string",
              "null"
            ],
            "description": "最近一次错误（连接/重连失败原因）；None 表示无错误"
          },
          "next_retry_in_ms": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int64",
            "description": "距下次自动重试的毫秒数；None 表示当前无排定的重试",
            "minimum": 0
          },
          "permanent_failure": {
            "type": "boolean",
            "description": "是否永久停用（凭据拒绝等，不再自动重试，需人工介入）"
          },
          "platform": {
            "type": "string",
            "example": "telegram"
          },
          "retry_attempt": {
            "type": "integer",
            "format": "int32",
            "description": "连续失败重试次数（瞬时失败自动重试中会递增）",
            "minimum": 0
          },
          "status": {
            "type": "string",
            "example": "Connected"
          }
        }
      },
      "AdapterListResponse": {
        "type": "object",
        "description": "适配器列表响应",
        "required": [
          "adapters"
        ],
        "properties": {
          "adapters": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/AdapterItem"
            }
          }
        }
      },
      "AdapterRuntimeConfig": {
        "type": "object",
        "description": "适配器运行时配置状态",
        "required": [
          "enabled",
          "token_configured",
          "extra"
        ],
        "properties": {
          "enabled": {
            "type": "boolean"
          },
          "extra": {},
          "token_configured": {
            "type": "boolean"
          }
        }
      },
      "AdapterState": {
        "type": "string",
        "description": "适配器状态",
        "enum": [
          "Created",
          "Starting",
          "Connecting",
          "Connected",
          "Reconnecting",
          "Failed",
          "Stopped"
        ]
      },
      "AdapterStatusSummary": {
        "type": "object",
        "description": "适配器状态摘要（对外 API 使用）",
        "required": [
          "platform",
          "display_name",
          "state",
          "connected",
          "messages_in",
          "messages_out"
        ],
        "properties": {
          "connected": {
            "type": "boolean"
          },
          "display_name": {
            "type": "string"
          },
          "health": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/HealthStatus"
              }
            ]
          },
          "last_error": {
            "type": [
              "string",
              "null"
            ]
          },
          "messages_in": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "messages_out": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "platform": {
            "type": "string"
          },
          "state": {
            "$ref": "#/components/schemas/AdapterState"
          },
          "uptime": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int64",
            "minimum": 0
          }
        }
      },
      "AdapterSummary": {
        "type": "object",
        "description": "适配器摘要",
        "required": [
          "total",
          "connected"
        ],
        "properties": {
          "connected": {
            "type": "integer",
            "minimum": 0
          },
          "total": {
            "type": "integer",
            "minimum": 0
          }
        }
      },
      "ApiConfig": {
        "type": "object",
        "description": "API 配置",
        "properties": {
          "basePath": {
            "type": "string"
          },
          "metrics": {
            "$ref": "#/components/schemas/MetricsConfig"
          },
          "rateLimit": {
            "$ref": "#/components/schemas/RateLimitConfig"
          },
          "rawPayloadEnabled": {
            "type": "boolean",
            "description": "是否在 WebSocket 事件中透传各平台的原始 payload（metadata 字段）。\n开发/调试时开启便于排查适配问题，生产环境建议关闭。"
          },
          "websocket": {
            "$ref": "#/components/schemas/WebSocketConfig"
          }
        }
      },
      "ApiErrorDetail": {
        "type": "object",
        "description": "API 错误详情",
        "required": [
          "code",
          "message"
        ],
        "properties": {
          "code": {
            "type": "string"
          },
          "details": {},
          "message": {
            "type": "string"
          }
        }
      },
      "ApiErrorResponse": {
        "type": "object",
        "description": "API 错误响应格式",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ApiErrorDetail"
          }
        }
      },
      "ApiKeyResponse": {
        "type": "object",
        "description": "API Key 列表响应项（不含 raw key）",
        "required": [
          "id",
          "subject_id",
          "name",
          "prefix",
          "created_at",
          "revoked",
          "permissions"
        ],
        "properties": {
          "created_at": {
            "type": "integer",
            "format": "int64"
          },
          "expires_at": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int64"
          },
          "id": {
            "type": "string"
          },
          "last_used_at": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int64"
          },
          "name": {
            "type": "string"
          },
          "permissions": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "prefix": {
            "type": "string"
          },
          "requests_per_minute": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int32",
            "minimum": 0
          },
          "revoked": {
            "type": "boolean"
          },
          "subject_id": {
            "type": "string"
          }
        }
      },
      "ApiKeyRotationTransition": {
        "type": "object",
        "required": [
          "source_id",
          "replacement_id",
          "state",
          "created_at",
          "source_revoked",
          "replacement_revoked"
        ],
        "properties": {
          "created_at": {
            "type": "integer",
            "format": "int64"
          },
          "replacement_id": {
            "type": "string"
          },
          "replacement_revoked": {
            "type": "boolean"
          },
          "source_id": {
            "type": "string"
          },
          "source_revoked": {
            "type": "boolean"
          },
          "state": {
            "type": "string"
          }
        }
      },
      "ApiKeyTypesResponse": {
        "type": "object",
        "description": "可用事件类型和权限列表",
        "required": [
          "event_types",
          "permissions"
        ],
        "properties": {
          "event_types": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "permissions": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "AuditEvent": {
        "type": "object",
        "description": "Immutable management audit event. Hashes form an ordered chain so deletion\nor modification is detectable during verification.",
        "required": [
          "id",
          "timestamp",
          "actor_id",
          "action",
          "resource",
          "metadata",
          "previous_hash",
          "event_hash"
        ],
        "properties": {
          "action": {
            "type": "string"
          },
          "actor_id": {
            "type": "string"
          },
          "event_hash": {
            "type": "string"
          },
          "id": {
            "type": "string"
          },
          "metadata": {},
          "previous_hash": {
            "type": "string"
          },
          "resource": {
            "type": "string"
          },
          "timestamp": {
            "type": "integer",
            "format": "int64"
          }
        }
      },
      "AuditEventsResponse": {
        "type": "object",
        "required": [
          "integrity_valid",
          "events"
        ],
        "properties": {
          "events": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/AuditEvent"
            }
          },
          "integrity_valid": {
            "type": "boolean"
          }
        }
      },
      "BatchSendRequest": {
        "type": "object",
        "description": "批量发送请求",
        "required": [
          "targets",
          "text"
        ],
        "properties": {
          "parse_mode": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/ParseMode",
                "description": "文本解析模式"
              }
            ]
          },
          "targets": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "目标列表，每个元素格式 \"platform:chatId\"",
            "example": [
              "telegram:123456",
              "telegram:789012"
            ]
          },
          "text": {
            "type": "string",
            "description": "消息文本",
            "example": "Broadcast message"
          }
        }
      },
      "BillingEvent": {
        "type": "object",
        "required": [
          "provider",
          "event_id",
          "event_type",
          "object_id",
          "customer_ref",
          "amount_minor",
          "currency",
          "occurred_at",
          "received_at",
          "event_hash"
        ],
        "properties": {
          "amount_minor": {
            "type": "integer",
            "format": "int64"
          },
          "currency": {
            "type": "string"
          },
          "customer_ref": {
            "type": "string"
          },
          "event_hash": {
            "type": "string"
          },
          "event_id": {
            "type": "string"
          },
          "event_type": {
            "type": "string"
          },
          "object_id": {
            "type": "string"
          },
          "occurred_at": {
            "type": "integer",
            "format": "int64"
          },
          "provider": {
            "type": "string"
          },
          "received_at": {
            "type": "integer",
            "format": "int64"
          }
        }
      },
      "BillingEventQuery": {
        "type": "object",
        "required": [
          "from",
          "to"
        ],
        "properties": {
          "customer_ref": {
            "type": [
              "string",
              "null"
            ]
          },
