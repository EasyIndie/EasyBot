    "/api/v1/messages/batch-send": {
      "post": {
        "tags": [
          "Messages"
        ],
        "summary": "批量发送消息",
        "description": "向多个目标发送相同的文本消息。每个目标格式为 \"platform:chatId\"。\n权限按 target 独立校验：无权限的目标以 `results` 中 `failed` 记录，不阻断有权限目标投递；\n仅当全部目标都无权限时整体返回 403。使用并发限制（最大 5 个并发）和整体 30 秒超时。",
        "operationId": "batch_send",
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "description": "8-128 safe ASCII characters; retained 24 hours",
            "required": false,
