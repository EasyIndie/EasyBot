# syntax=docker/dockerfile:1
# EasyBot — Release Docker Image (pre-built binary)
# Uses musl binaries produced by the build-binaries CI job, skipping Rust compilation.
FROM alpine:3.22@sha256:14358309a308569c32bdc37e2e0e9694be33a9d99e68afb0f5ff33cc1f695dce

# The base digest is pinned to the Alpine build snapshot, but Alpine rebuilds the
# 3.22 base on its own cadence — a freshly released openssl fix can postdate the
# image. Upgrade system packages at build time so the runtime image never ships
# an unfixed CVE (e.g. openssl 3.5.8-r0 in v3.22/main fixes CVE-2026-14456).
RUN apk upgrade --no-cache

RUN addgroup -S -g 10001 easybot \
    && adduser -S -D -H -u 10001 -G easybot easybot \
    && mkdir -p /var/lib/easybot/data /var/lib/easybot/logs /var/lib/easybot/plugins /etc/easybot \
    && chown -R easybot:easybot /var/lib/easybot /etc/easybot

# TARGETARCH is auto-injected by Docker Buildx during multi-platform builds
# (amd64 for x86_64 builds, arm64 for aarch64 builds)
ARG TARGETARCH
COPY --chown=easybot:easybot dist/easybot-${TARGETARCH} /usr/local/bin/easybot
RUN chmod +x /usr/local/bin/easybot

# 内置容器化默认配置（server.host: 0.0.0.0，保证 -p 端口发布可达）。
# 用户挂载自己的 gateway.yaml 时会覆盖此文件。
COPY --chown=easybot:easybot deploy/gateway.container.yaml /etc/easybot/gateway.yaml

USER easybot
EXPOSE 8080
HEALTHCHECK --interval=30s --timeout=5s --retries=3 CMD ["wget", "-q", "-O", "/dev/null", "http://127.0.0.1:8080/api/v1/live"]
ENTRYPOINT ["easybot"]
CMD ["--config", "/etc/easybot/gateway.yaml"]
